---
import { getRelativeLocaleUrl } from "astro:i18n";
import {
  getPathWithoutLang,
  languages,
  toLang,
  ui,
  type Lang,
} from "../i18n/ui";

interface Props {
  class?: string;
}

const currentLang = toLang(Astro.currentLocale);
const path = getPathWithoutLang(Astro.url.pathname);
const options = Object.entries(languages) as [Lang, string][];
---

<nav
  aria-label={ui[currentLang].nav.language}
  class:list={[
    "flex items-center gap-2 font-mono text-xs font-bold uppercase tracking-widest",
    Astro.props.class,
  ]}
>
  {
    options.map(([lang, label], index) => (
      <>
        {index > 0 && (
          <span aria-hidden="true" class="opacity-40">
            /
          </span>
        )}
        <a
          href={getRelativeLocaleUrl(lang, path)}
          hreflang={lang}
          lang={lang}
          aria-current={lang === currentLang ? "page" : undefined}
          class:list={[
            "language-link transition-opacity",
            lang === currentLang ? "opacity-100" : "opacity-40 hover:opacity-100",
          ]}
        >
          {label}
        </a>
      </>
    ))
  }
</nav>

<script>
  // Keep the visitor on the same section when switching language
  document
    .querySelectorAll<HTMLAnchorElement>(".language-link")
    .forEach((link) => {
      link.addEventListener("click", () => {
        link.hash = window.location.hash;
      });
    });
</script>
