---
---
<section id="audio" class="px-6 sm:px-12 py-24 border-t border-white/20 relative z-10 bg-black">
  <div class="mb-16 flex flex-col w-full border-b border-white/20 pb-8">
    <h2 class="display-text text-[15vw] leading-[0.8] tracking-tighter text-white m-0">AUDIO</h2>
    <h2 class="display-text text-[15vw] leading-[0.8] tracking-tighter text-white m-0 ">ARCHIVE</h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 border-t border-white/20 pt-8">
    
    <!-- Mix 1 -->
    <div class="border border-white/20 p-8 group hover:border-[#ffffff] transition-colors">
      <div class="flex justify-between items-start mb-12">
        <span class="display-text text-5xl text-transparent" style="-webkit-text-stroke: 1px #555;">01</span>
        <span class="text-[10px] uppercase tracking-widest font-mono text-[#ffffff] border border-[#ffffff] px-2 py-1">LIVE SET</span>
      </div>
      <h3 class="display-text text-3xl mb-4 group-hover:text-[#ffffff] transition-colors">FOLD, LONDON</h3>
      <p class="text-xs font-mono text-gray-400 uppercase tracking-widest mb-8">2H INDUSTRIAL TECHNO MIX</p>
      <button class="w-full py-4 bg-white text-black font-mono text-xs font-bold uppercase tracking-widest hover:bg-[#ffffff] transition-colors">LISTEN</button>
    </div>

    <!-- Mix 2 -->
    <div class="border border-white/20 p-8 group hover:border-[#ffffff] transition-colors">
      <div class="flex justify-between items-start mb-12">
        <span class="display-text text-5xl text-transparent" style="-webkit-text-stroke: 1px #555;">02</span>
        <span class="text-[10px] uppercase tracking-widest font-mono text-[#ffffff] border border-[#ffffff] px-2 py-1">PODCAST</span>
      </div>
      <h3 class="display-text text-3xl mb-4 group-hover:text-[#ffffff] transition-colors">HATE PODCAST 355</h3>
      <p class="text-xs font-mono text-gray-400 uppercase tracking-widest mb-8">STUDIO MIX // 145 BPM</p>
      <button class="w-full py-4 bg-white text-black font-mono text-xs font-bold uppercase tracking-widest hover:bg-[#ffffff] transition-colors">LISTEN</button>
    </div>

  </div>
</section>
