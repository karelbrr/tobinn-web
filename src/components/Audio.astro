---
import { getCollection } from 'astro:content';

const audio = await getCollection('audio');
// Sort by ID to keep the numeric order
const mixes = audio.map(a => a.data).sort((a, b) => parseInt(a.id) - parseInt(b.id));
---

<section
  id="audio"
  class="py-12 lg:py-24 border-t border-white/20 relative z-10 bg-black w-full overflow-hidden"
>
  <div class="flex flex-col w-full border-b border-white/20 pb-8 lg:pb-16">
    <h2
      class="display-text text-[clamp(3rem,15vw,220px)] leading-[0.8] tracking-tighter text-white m-0 px-6 sm:px-12"
    >
      AUDIO
    </h2>
    <h2
      class="display-text text-[clamp(3rem,15vw,220px)] leading-[0.8] tracking-tighter text-white m-0 px-6 sm:px-12"
    >
      ARCHIVE
    </h2>
  </div>

  <div
    class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-8 lg:pt-16 px-6 sm:px-12"
  >
    {
      mixes.map((mix) => (
        <div class="border border-white/20 p-8 group hover:border-[#ffffff] transition-colors">
          <div class="flex justify-between items-start mb-12">
            <span class="display-text text-5xl text-white">{mix.id}</span>
            <span class="text-[10px] uppercase tracking-widest font-mono bg-white text-black font-bold px-2 py-1">
              {mix.type}
            </span>
          </div>
          <h3 class="display-text text-3xl mb-4 group-hover:text-[#ffffff] transition-colors">
            {mix.title}
          </h3>
          <p class="text-xs font-mono uppercase tracking-widest mb-8">
            {mix.description}
          </p>
          <button class="w-full py-4 bg-white text-black font-mono text-xs font-bold uppercase tracking-widest hover:bg-[#ffffff] transition-colors">
            LISTEN
          </button>
        </div>
      ))
    }
  </div>
</section>
