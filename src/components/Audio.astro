---
import { getCollection } from "astro:content";
import { toLang, ui } from "../i18n/ui";

const { audio: t } = ui[toLang(Astro.currentLocale)];

const audio = await getCollection("audio");
// Sort by ID to keep the numeric order
const mixes = audio
  .map((a) => a.data)
  .sort((a, b) => parseInt(a.id) - parseInt(b.id));
---

<!-- The crowd shot; hovering a mix spins the records faster and gets the crowd jumping with hands up -->
<section id="audio" data-stage-key="crowd" class="relative min-h-svh flex items-end lg:items-center px-gutter py-section">
  <div data-presence class="w-full max-w-column flex flex-col gap-8">
    <h2 class="text-heading m-0">{t.heading}</h2>
    {
      mixes.length === 0 ? (
        <div class="flex flex-col gap-3">
          <p class="text-lead m-0">{t.emptyTitle}</p>
          <p class="text-paper/70 m-0">{t.emptyText}</p>
          <a href="https://www.instagram.com/djtobinn" target="_blank" rel="noopener" class="self-start underline underline-offset-4 decoration-paper/40 hover:decoration-paper transition-colors">
            {t.emptyCta} ↗
          </a>
        </div>
      ) : (
        mixes.map((mix) => (
          <article data-stage-boost class="flex flex-col gap-3">
            <p class="text-caption font-mono text-paper/60 m-0">
              {mix.id} · <span class="lowercase first-letter:uppercase inline-block">{mix.type}</span>
            </p>
            <h3 class="text-lead m-0 lowercase first-letter:uppercase">{mix.title}</h3>
            <p class="text-paper/70 m-0 lowercase first-letter:uppercase">{mix.description}</p>
            <a href={mix.url} target="_blank" rel="noopener" class="self-start mt-2 underline underline-offset-4 decoration-paper/40 hover:decoration-paper transition-colors">
              {t.listen} ↗
            </a>
          </article>
        ))
      )
    }
  </div>
</section>
