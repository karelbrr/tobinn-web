---
import dates from '../data/tour.json';
---

<section
  id="tour"
  class="py-12 lg:py-24 border-t border-white/20 relative z-10 w-full overflow-hidden"
>
  <div class="flex flex-col w-full border-b border-white/20 pb-8 lg:pb-16">
    <h2
      class="display-text text-[15vw] leading-[0.8] tracking-tighter text-white m-0 px-6 sm:px-12"
    >
      TOUR
    </h2>
    <h2
      class="display-text text-[15vw] leading-[0.8] tracking-tighter text-white m-0 px-6 sm:px-12"
    >
      DATES
    </h2>
  </div>

  <div class="flex flex-col pt-8 lg:pt-16 px-6 sm:px-12">
    {
      dates.map((item) => (
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center py-6 sm:py-8 border-b border-white/20 group hover:bg-[#ffffff] transition-colors cursor-crosshair px-4 -mx-4">
          <div class="flex flex-col sm:flex-row sm:items-center gap-2 md:gap-8 lg:gap-16 w-full sm:w-auto">
            <span class="text-xs sm:text-sm uppercase tracking-wider group-hover:text-black font-mono transition-colors">
              {item.date}
            </span>
            <span class="display-text text-3xl md:text-4xl lg:text-5xl group-hover:text-black transition-colors">
              {item.city}
            </span>
          </div>
          <div class="mt-4 sm:mt-0 flex justify-between w-full sm:w-auto items-center sm:gap-6 md:gap-16">
            <span class="text-xs sm:text-sm uppercase tracking-widest text-white group-hover:text-black font-mono transition-colors truncate">
              {item.venue}
            </span>
          </div>
        </div>
      ))
    }
  </div>
</section>
