---
import { getTourDates, isPastTour } from "../lib/tours";
import { toLang, ui } from "../i18n/ui";

const { tour, hero } = ui[toLang(Astro.currentLocale)];

// Next gig first; past gigs follow, most recent first
const tourDates = await getTourDates();
const dates = [
  ...tourDates.filter((item) => !isPastTour(item)),
  ...tourDates.filter(isPastTour).reverse(),
];
const nextIndex = dates.findIndex((item) => !isPastTour(item));
---

<!-- Hovering an upcoming date turns the beam onto the speaker -->
<section id="tour" data-stage-key="speaker" class="relative min-h-svh flex items-end lg:items-center px-gutter py-section">
  <div data-presence class="w-full max-w-column flex flex-col gap-8">
    <h2 class="text-heading m-0">{tour.heading}</h2>
    <ol class="flex flex-col m-0 p-0 list-none">
      {
        dates.map((item, index) => {
          const isPast = isPastTour(item);
          return (
            <li
              data-stage-spot={isPast ? undefined : ""}
              class:list={[
                "grid grid-cols-[5.5rem_1fr] gap-x-4 py-4 border-t border-line transition-colors",
                isPast ? "text-paper/55" : "text-paper/85 hover:text-paper",
              ]}
            >
              <span class="text-caption font-mono pt-1 tabular-nums">{item.date}</span>
              <span class="flex flex-col">
                <span class:list={[isPast && "line-through"]}>{item.city}</span>
                <span class="text-caption text-paper/55">
                  {item.venue}
                  {index === nextIndex && <span class="ml-2 text-paper">· {hero.next}</span>}
                  {isPast && <span class="ml-2">· {tour.past}</span>}
                </span>
              </span>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>
