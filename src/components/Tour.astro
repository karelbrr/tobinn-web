---
import { getCollection } from "astro:content";

const tours = await getCollection("tours");

const parseDate = (dateString: string) => {
  const [day, month, year] = dateString.split(".");
  // Assumes 20YY format
  return new Date(
    `20${year}-${month.padStart(2, "0")}-${day.padStart(2, "0")}`,
  );
};

const dates = tours
  .map((t) => t.data)
  .sort((a, b) => parseDate(a.date).getTime() - parseDate(b.date).getTime());

const now = new Date();
now.setHours(0, 0, 0, 0); // Reset time to start of day for accurate comparison
---

<section
  id="tour"
  class="py-12 lg:py-24 border-t border-white/20 relative z-10 w-full overflow-hidden"
>
  <div class="flex flex-col w-full border-b border-white/20 pb-8 lg:pb-16">
    <h2
      class="display-text text-[clamp(3rem,15vw,220px)] leading-[0.8] tracking-tighter text-white m-0 px-6 sm:px-12"
    >
      TOUR
    </h2>
    <h2
      class="display-text text-[clamp(3rem,15vw,220px)] leading-[0.8] tracking-tighter text-white m-0 px-6 sm:px-12"
    >
      DATES
    </h2>
  </div>

  <div class="flex flex-col pt-8 lg:pt-16 px-6 sm:px-12">
    {
      dates.map((item) => {
        const isPast = parseDate(item.date) < now;

        return (
          <div
            class={`flex flex-col sm:flex-row justify-between items-start sm:items-center py-6 sm:py-8 border-b border-white/20 px-4 -mx-4 transition-all duration-300 ${isPast ? "opacity-70 cursor-default grayscale" : "group hover:bg-[#ffffff]"}`}
          >
            <div class="flex flex-col sm:flex-row sm:items-center gap-2 md:gap-8 lg:gap-16 w-full sm:w-auto">
              <span
                class={`text-xs sm:text-sm uppercase tracking-wider font-mono transition-colors ${isPast ? "text-white" : "text-white group-hover:text-black"}`}
              >
                {item.date}
              </span>
              <span
                class={`display-text text-3xl md:text-4xl lg:text-5xl transition-colors ${isPast ? "line-through decoration-white/60 text-white" : "text-white group-hover:text-black"}`}
              >
                {item.city}
              </span>
            </div>
            <div class="mt-4 sm:mt-0 flex justify-between w-full sm:w-auto items-center sm:gap-6 md:gap-16">
              <span
                class={`text-xs sm:text-sm uppercase tracking-widest font-mono transition-colors truncate ${isPast ? "text-white" : "text-white group-hover:text-black"}`}
              >
                {item.venue}{" "}
                {isPast && <span class="ml-1">(PAST)</span>}
              </span>
            </div>
          </div>
        );
      })
    }
  </div>
</section>
