---
---
<section id="horizontal-scroll-container" class="relative h-[400vh] bg-[#050505]">
  <div class="sticky top-0 h-screen w-full overflow-hidden flex items-center border-t-2 border-b-2 border-white/20">
    <!-- Background Grid -->
    <div class="absolute inset-0 pointer-events-none bg-[linear-gradient(to_right,#facc1520_1px,transparent_1px),linear-gradient(to_bottom,#facc1520_1px,transparent_1px)] bg-size-[4rem_4rem]"></div>
    
    <div id="horizontal-scroll-content" class="flex h-full w-[400%] will-change-transform">
      
      <!-- Panel 1 -->
      <div class="w-1/4 h-full flex flex-col justify-center px-8 sm:px-16 lg:px-24 border-r-2 border-white/20 relative overflow-hidden">
        <img src="/images/crowd.jpg" alt="Rave crowd" class="absolute inset-0 w-full h-full object-cover opacity-30 grayscale pointer-events-none z-0" />
        <div class="relative z-10">
          <h2 class="display-text text-[15vw] leading-[0.8] tracking-tighter text-transparent" style="-webkit-text-stroke: 2px #fff;">
            SYSTEM
          </h2>
          <p class="mt-8 font-mono text-sm max-w-sm opacity-70 uppercase tracking-widest text-white">
            Initiating high-voltage set. <br/>
            Scroll down to move laterally.
          </p>
        </div>
        <div class="absolute top-1/4 right-1/4 w-32 h-32 bg-yellow-400 animate-pulse mix-blend-difference rounded-full blur-xl z-20"></div>
      </div>
      
      <!-- Panel 2 -->
      <div class="w-1/4 h-full flex flex-col justify-center px-8 sm:px-16 lg:px-24 border-r-2 border-white/20 bg-yellow-400 text-[#050505] relative overflow-hidden">
        <!-- Background elements -->
        <div class="absolute inset-0 bg-[repeating-linear-gradient(90deg,transparent,transparent_10px,rgba(0,0,0,0.1)_10px,rgba(0,0,0,0.1)_20px)] mix-blend-overlay z-0"></div>
        <img src="/images/decks.jpg" alt="DJ Decks" class="absolute right-0 top-1/4 w-3/4 max-w-lg h-auto object-cover grayscale mix-blend-multiply opacity-80 pointer-events-none z-10" />
        
        <div class="relative z-20">
          <h2 class="display-text text-[15vw] leading-[0.8] tracking-tighter text-white mix-blend-difference">
            OVERRIDE
          </h2>
        </div>
        
        <p class="absolute bottom-12 left-12 sm:left-24 max-w-xs text-xs sm:text-sm uppercase tracking-widest font-bold text-yellow-400 border-2 border-[#050505] p-4 bg-[#050505] z-30">
          Seamless transitions. <br/>
          Raw mix output. <br/>
          Audio levels critical.
        </p>
      </div>

      <!-- Panel 3 -->
      <div class="w-1/4 h-full flex flex-col justify-center px-8 sm:px-16 lg:px-24 border-r-2 border-white/20 bg-white text-black relative overflow-hidden">
        <img src="/images/warehouse.jpg" alt="Warehouse Rave" class="absolute inset-0 w-full h-full object-cover grayscale opacity-20 pointer-events-none z-0" />
        <div class="relative z-10 flex flex-col h-full justify-center w-full">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 w-full h-[40vh] mb-8">
          <div class="border-2 border-black p-4 flex flex-col justify-end font-bold uppercase hover:bg-black hover:text-white transition-all cursor-crosshair">
            <span class="text-xs opacity-50 mb-auto">Deck 1</span>
            <span class="text-2xl">MIXER</span>
          </div>
          <div class="border-2 border-black p-4 flex flex-col justify-end font-bold uppercase hover:bg-yellow-400 hover:text-white transition-all cursor-crosshair">
            <span class="text-xs opacity-50 mb-auto">Deck 2</span>
            <span class="text-2xl">TEMPO</span>
          </div>
          <div class="border-2 border-black p-4 flex flex-col justify-end font-bold uppercase bg-black text-white hover:bg-yellow-400 transition-all cursor-crosshair">
            <span class="text-xs opacity-50 mb-auto text-yellow-400">Warning</span>
            <span class="text-2xl">REDLINE</span>
          </div>
          <div class="border-2 border-black p-4 flex flex-col justify-end font-bold uppercase hover:bg-black hover:text-white transition-all cursor-crosshair">
            <span class="text-xs opacity-50 mb-auto">Channel</span>
            <span class="text-2xl">FADER</span>
          </div>
        </div>
        <h2 class="display-text text-[8vw] tracking-tighter leading-none mt-auto mb-12">
          SELECTION
        </h2>
        </div>
      </div>

      <!-- Panel 4 -->
      <div class="w-1/4 h-full flex items-center justify-center bg-[#050505] text-yellow-400 relative overflow-hidden group">
        <div class="absolute inset-0 bg-[repeating-linear-gradient(45deg,transparent,transparent_40px,#facc15_40px,#facc15_80px)] opacity-5 group-hover:opacity-20 transition-opacity duration-700"></div>
        <h2 class="display-text text-[10vw] lg:text-[12vw] leading-[0.9] text-center z-10 bg-[#050505]/80 p-8 lg:p-12 border-4 border-yellow-400 backdrop-blur-sm mix-blend-screen shadow-[8px_8px_0px_0px_rgba(250,204,21,1)]">
          NO <br/> COMPROMISE
        </h2>
      </div>

    </div>
  </div>
</section>

<script>
  const setupHorizontalScroll = () => {
    const container = document.getElementById("horizontal-scroll-container");
    const content = document.getElementById("horizontal-scroll-content");
    
    if (!container || !content) return;

    const onScroll = () => {
      // Calculate where the container is relative to the viewport
      const rect = container.getBoundingClientRect();
      const viewportHeight = window.innerHeight;
      
      // If the container is sticky (its top is at or above the viewport top, and bottom is below viewport bottom)
      if (rect.top <= 0 && rect.bottom >= viewportHeight) {
        const scrollableDistance = rect.height - viewportHeight;
        const scrolledDistance = -rect.top;
        const progress = scrolledDistance / scrollableDistance;
        
        // Calculate max horizontal scroll based on actual rendered widths
        const maxScroll = content.scrollWidth - container.clientWidth;
        
        // Apply transform
        content.style.transform = `translate3d(-${progress * maxScroll}px, 0, 0)`;
      } else if (rect.top > 0) {
        content.style.transform = `translate3d(0, 0, 0)`;
      } else if (rect.bottom < viewportHeight) {
        const maxScroll = content.scrollWidth - container.clientWidth;
        content.style.transform = `translate3d(-${maxScroll}px, 0, 0)`;
      }
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    
    // Initial call to set correct position on load
    onScroll();
  };

  // Run script
  setupHorizontalScroll();
</script>
