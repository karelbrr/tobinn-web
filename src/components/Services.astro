---
import { toLang, ui } from "../i18n/ui";

const { services } = ui[toLang(Astro.currentLocale)];
---

<section
  id="services"
  class="py-12 lg:py-24 border-t border-white/20 relative z-10 w-full overflow-hidden"
>
  <div class="flex flex-col w-full border-b border-white/20 pb-8 lg:pb-16">
    {
      services.heading.map((line) => (
        <h2 class="display-text text-[clamp(3rem,15vw,220px)] leading-[0.8] tracking-tighter text-white m-0 px-6 sm:px-12">
          {line}
        </h2>
      ))
    }
  </div>

  <div class="flex flex-col gap-8 pt-8 lg:pt-16 px-6 sm:px-12">
    <p
      class="max-w-3xl text-base sm:text-xl lg:text-2xl leading-relaxed text-white/80 font-light"
    >
      {services.intro}
    </p>

    <ul class="flex flex-wrap gap-2">
      {
        services.genres.map((genre) => (
          <li class="text-[10px] sm:text-xs uppercase tracking-widest font-mono bg-white text-black font-bold px-2 py-1">
            {genre}
          </li>
        ))
      }
    </ul>

    <ul class="flex flex-col border-t border-white/20">
      {
        services.items.map((item) => (
          <li class="group flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 py-6 sm:py-8 border-b border-white/20 px-4 -mx-4 transition-all duration-300 hover:bg-white">
            <h3 class="display-text text-3xl md:text-4xl lg:text-5xl text-white group-hover:text-black transition-colors m-0">
              {item.title}
            </h3>
            <span class="text-xs sm:text-sm uppercase tracking-widest font-mono text-white group-hover:text-black transition-colors">
              {item.detail}
            </span>
          </li>
        ))
      }
    </ul>

    <p
      class="text-xs sm:text-sm uppercase tracking-widest font-mono font-bold text-white"
    >
      {services.area}
    </p>
  </div>
</section>
