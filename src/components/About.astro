---
import { toLang, ui } from "../i18n/ui";

const { about, services } = ui[toLang(Astro.currentLocale)];
---

<!-- Who the DJ is and what he plays for whom: About and Services in one -->
<section id="about" data-stage-key="deck-close" class="relative min-h-svh flex items-end lg:items-center px-gutter py-section">
  <div data-presence class="max-w-column flex flex-col gap-8">
    <h2 class="text-heading m-0">{about.heading}</h2>
    <p class="text-lead text-paper/85 m-0">{about.text}</p>
    <ul class="flex flex-col gap-3 m-0 p-0 list-none">
      {
        services.items.map((item) => (
          <li class="flex flex-col">
            <span class="text-paper">{item.title}</span>
            <span class="text-caption text-paper/60">{item.detail}</span>
          </li>
        ))
      }
    </ul>
    <p class="text-caption font-mono text-paper/60 m-0">
      {services.genres.join(" · ")}<br />{services.area}
    </p>
  </div>
</section>
