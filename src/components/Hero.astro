---
import { toLang, ui } from "../i18n/ui";
import { getTourDates, isPastTour } from "../lib/tours";

const { hero } = ui[toLang(Astro.currentLocale)];
const next = (await getTourDates()).find((tour) => !isPastTour(tour));
---

<header
  id="hero"
  data-stage-key="deck-wide"
  class="relative min-h-svh flex flex-col justify-end px-gutter pb-gutter pt-28"
>
  <div class="max-w-column flex flex-col gap-6 pb-8">
    <h1 data-split class="text-display m-0 text-paper">DJ Tobinn</h1>
    <p data-hero-fade class="text-lead text-paper/75 m-0">{hero.tagline}</p>
    {
      next && (
        <a data-hero-fade href="#tour" class="group flex items-baseline gap-3 text-caption font-mono text-paper/60 hover:text-paper transition-colors">
          <span>{hero.next}</span>
          <span class="text-paper group-hover:underline underline-offset-4">
            {next.date} · {next.city}
          </span>
        </a>
      )
    }
  </div>
</header>
