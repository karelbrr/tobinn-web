<header class="relative w-full lg:min-h-[30vh] bg-[#050505] overflow-hidden">
  <div
    class="relative z-10 w-full px-6 sm:px-12 flex flex-col items-center @container"
  >
    <!-- Massive Text -->
    <h1
      class="flex justify-between w-full font-sans font-extrabold text-[17.5cqw] leading-[0.8] uppercase m-0 p-0 pt-10 select-none text-white whitespace-nowrap opacity-90"
    >
      <span class="ml-[-0.06em]">D</span><span>J</span><span>T</span><span
        >O</span
      ><span>B</span><span>I</span><span>N</span><span class="mr-[-0.05em]"
        >N</span
      >
    </h1>

    <!-- Nav Links -->
    <nav
      class="flex justify-between w-full uppercase pb-5 text-[10px] sm:text-xs md:text-sm font-bold tracking-widest mt-8 md:mt-12 font-mono text-white"
    >
      <a href="#about" class="hover:text-gray-400 transition-colors">About</a>
      <a href="#tour" class="hover:text-gray-400 transition-colors">Tour</a>
      <a href="#audio" class="hover:text-gray-400 transition-colors">Audio</a>
      <a href="#book" class="hover:text-gray-400 transition-colors">Book</a>
    </nav>
  </div>
</header>
