<footer
  class="w-full bg-white text-black border-t-4 border-black overflow-hidden relative selection:bg-black selection:text-[#C0C0C0]"
>
  <!-- Main Footer Content -->
  <div
    class="w-full px-6 sm:px-12 pb-12 grid grid-cols-1 md:grid-cols-2 gap-12 items-end"
  >
    <!-- Abstract / Brutalist Info -->
    <div class="flex flex-col gap-4 pt-5 lg:pt-0">
      <div class="flex flex-col gap-2">
        <a
          href="mailto:booking@tobinn.xyz"
          class="font-sans font-extrabold text-4xl sm:text-6xl uppercase tracking-tighter"
        >
          BOOKING
        </a>
        <a
          href="https://instagram.com"
          class="font-sans font-extrabold text-4xl sm:text-6xl uppercase tracking-tighter"
        >
          INSTAGRAM
        </a>
      </div>
    </div>

    <!-- Right Side: Year & Technical Links -->
    <div
      class="flex flex-col items-start md:items-end w-full h-full justify-between gap-12 md:gap-0"
    >
      <!-- Massive Year -->
      <h2
        class="font-sans font-extrabold text-[25vw] md:text-[12vw] leading-[0.75] tracking-tighter m-0 p-0 text-black mix-blend-difference"
      >
        '26
      </h2>

      <div
        class="flex flex-col items-start lg:items-end w-full gap-6 lg:gap-4 mt-8"
      >
        <div
          class="font-mono text-[10px] sm:text-xs font-bold uppercase tracking-widest flex flex-col items-start lg:items-end text-left lg:text-right gap-1"
        >
          <span>&copy; {new Date().getFullYear()} DJTOBINN.</span>
          <span>ALL RIGHTS RESERVED.</span>
        </div>

        <div
          class="flex flex-col items-start lg:items-end gap-1 font-mono text-[10px] sm:text-xs font-bold uppercase tracking-widest text-black text-left lg:text-right"
        >
          <a href="/privacy" class="hover:text-black transition-all"
            >PRIVACY POLICY</a
          >
          <a href="/terms" class="hover:text-black transition-all"
            >TERMS & CONDITIONS</a
          >
          <a
            href="https://karelbraborec.com"
            target="_blank"
            class="hover:text-black transition-all text-black"
            >KARELBRABOREC.COM</a
          >
        </div>
      </div>
    </div>
  </div>
</footer>
