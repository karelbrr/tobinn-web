<footer
  class="w-full bg-[#C0C0C0] text-black border-t-4 border-black overflow-hidden relative selection:bg-black selection:text-[#C0C0C0]"
>
  <!-- Marquee Banner -->
  <div
    class="w-full border-b-4 border-black py-3 flex overflow-hidden whitespace-nowrap bg-black text-[#C0C0C0]"
  >
    <div
      class="animate-[marquee_20s_linear_infinite] flex gap-4 font-mono text-sm sm:text-base font-bold uppercase tracking-widest"
    >
      <span>// HOUSE</span>
      <span>// EDM</span>
      <span>// WHITE GIRL</span>
      <span>// TRANCE</span>
      <span>// HOUSE</span>
      <span>// EDM</span>
      <span>// WHITE GIRL</span>
      <span>// TRANCE</span>
      <span>// HOUSE</span>
      <span>// EDM</span>
      <span>// WHITE GIRL</span>
      <span>// TRANCE</span>
    </div>
    <!-- Duplicate for seamless loop -->
    <div
      class="animate-[marquee_20s_linear_infinite] flex gap-4 font-mono text-sm sm:text-base font-bold uppercase tracking-widest"
      aria-hidden="true"
    >
      <span>// HOUSE</span>
      <span>// EDM</span>
      <span>// WHITE GIRL</span>
      <span>// TRANCE</span>
      <span>// HOUSE</span>
      <span>// EDM</span>
      <span>// WHITE GIRL</span>
      <span>// TRANCE</span>
      <span>// HOUSE</span>
      <span>// EDM</span>
      <span>// WHITE GIRL</span>
      <span>// TRANCE</span>
    </div>
  </div>

  <style>
    @keyframes marquee {
      0% {
        transform: translateX(0%);
      }
      100% {
        transform: translateX(-100%);
      }
    }
  </style>

  <!-- Main Footer Content -->
  <div
    class="w-full max-w-7xl mx-auto px-6 sm:px-12 py-16 md:py-24 grid grid-cols-1 md:grid-cols-2 gap-12 items-end"
  >
    <!-- Abstract / Brutalist Info -->
    <div class="flex flex-col gap-8">
      <div class="flex flex-col gap-2">
        <a
          href="mailto:booking@tobinn.xyz"
          class="font-sans font-extrabold text-4xl sm:text-6xl uppercase tracking-tighter hover:italic transition-all origin-left"
        >
          BOOKING
        </a>
        <a
          href="https://instagram.com"
          class="font-sans font-extrabold text-4xl sm:text-6xl uppercase tracking-tighter hover:italic transition-all origin-left"
        >
          INSTAGRAM
        </a>
      </div>
    </div>

    <!-- Massive Year/Logo -->
    <div class="flex flex-col items-start md:items-end w-full">
      <h2
        class="font-sans font-extrabold text-[25vw] md:text-[15vw] leading-[0.75] tracking-tighter m-0 p-0 text-black mix-blend-difference"
      >
        '26
      </h2>
      <p class="font-mono text-xs font-bold uppercase tracking-widest mt-4">
        &copy; {new Date().getFullYear()} TOBIN SOUND.<br />ALL RIGHTS RESERVED.
      </p>
    </div>
  </div>
</footer>
