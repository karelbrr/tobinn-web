<footer
  class="w-full bg-white text-black pt-24 md:pt-50 border-t-4 border-black overflow-hidden relative selection:bg-black selection:text-[#C0C0C0]"
>
  <!-- Main Footer Content -->
  <div
    class="w-full px-6 sm:px-12 pb-12 grid grid-cols-1 md:grid-cols-2 gap-12 items-end"
  >
    <!-- Abstract / Brutalist Info -->
    <div class="flex flex-col gap-4 pt-5 md:pt-0">
      <div class="flex flex-col gap-2">
        <a
          href="mailto:booking@tobinn.xyz"
          class="font-sans font-extrabold text-4xl sm:text-6xl uppercase tracking-tighter"
        >
          BOOKING
        </a>
        <a
          target="_blank"
          href="https://www.instagram.com/djtobinn"
          class="font-sans font-extrabold text-4xl sm:text-6xl uppercase tracking-tighter"
        >
          INSTAGRAM
        </a>
      </div>
    </div>

    <!-- Right Side: Year & Technical Links -->
    <div
      class="flex flex-col items-start md:items-end w-full h-full justify-between gap-12 md:gap-0"
    >
      <div class="flex flex-col items-start md:items-end w-full gap-6 md:gap-4">
        <div
          class="flex flex-col items-start md:items-end gap-2 sm:gap-1 font-mono text-[10px] sm:text-xs font-bold uppercase tracking-widest text-black text-left md:text-right"
        >
          <a
            href="/privacy"
            class="py-2 sm:py-1 hover:text-gray-600 transition-all block"
            >PRIVACY POLICY</a
          >
          <a
            href="/terms"
            class="py-2 sm:py-1 hover:text-gray-600 transition-all block"
            >TERMS & CONDITIONS</a
          >
          <a
            href="https://karelbraborec.com"
            target="_blank"
            class="py-2 sm:py-1 hover:text-gray-600 transition-all text-black block"
            >KARELBRABOREC.COM</a
          >
        </div>

        <div
          class="font-mono text-[10px] sm:text-xs font-bold uppercase tracking-widest flex flex-col items-start md:items-end text-left md:text-right gap-1"
        >
          <span>&copy; {new Date().getFullYear()} DJTOBINN.</span>
          <span>ALL RIGHTS RESERVED.</span>
        </div>
      </div>
    </div>
  </div>
</footer>
