---

<footer
  class="w-full bg-white text-black border-t-4 border-black overflow-hidden relative selection:bg-black selection:text-[#C0C0C0]"
>
  <!-- Main Footer Content -->
  <div
    class="w-full max-w-7xl mx-auto px-6 sm:px-12 py-16 md:py-24 grid grid-cols-1 md:grid-cols-2 gap-12 items-end"
  >
    <!-- Abstract / Brutalist Info -->
    <div class="flex flex-col gap-4">
      <div class="flex flex-col gap-2">
        <a
          href="mailto:booking@tobinn.xyz"
          class="font-sans font-extrabold text-4xl sm:text-6xl uppercase tracking-tighter"
        >
          BOOKING
        </a>
        <a
          href="https://instagram.com"
          class="font-sans font-extrabold text-4xl sm:text-6xl uppercase tracking-tighter"
        >
          INSTAGRAM
        </a>
      </div>
    </div>

    <!-- Massive Year/Logo -->
    <div class="flex flex-col items-start md:items-end w-full">
      <h2
        class="font-sans font-extrabold text-[25vw] md:text-[15vw] leading-[0.75] tracking-tighter m-0 p-0 text-black mix-blend-difference"
      >
        '26
      </h2>
      <div
        class="flex flex-col sm:flex-row items-start sm:items-end justify-between w-full mt-4 gap-4"
      >
        <p class="font-mono text-xs font-bold uppercase tracking-widest">
          &copy; {new Date().getFullYear()} DJTOBINN.<br />ALL RIGHTS RESERVED.
        </p>
        <div
          class="flex flex-col sm:flex-row gap-2 sm:gap-4 font-mono text-[10px] sm:text-xs font-bold uppercase tracking-widest text-black sm:text-right"
        >
          <a href="/privacy" class="hover:text-black transition-colors"
            >PRIVACY_POLICY</a
          >

          <a href="/terms" class="hover:text-black transition-colors"
            >TERMS_&_CONDITIONS</a
          >
        </div>
      </div>
    </div>
  </div>
</footer>
