---
import { getRelativeLocaleUrl } from "astro:i18n";
import { toLang, ui } from "../i18n/ui";

const lang = toLang(Astro.currentLocale);
const { footer: t } = ui[lang];
const linkClass = "py-2 hover:text-paper transition-colors";
---

<footer class="relative z-10 bg-ink border-t border-line px-gutter py-8">
  <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-2 text-caption text-paper/60">
    <span>&copy; {new Date().getFullYear()} DJ Tobinn. {t.rightsReserved}</span>
    <nav class="flex flex-wrap gap-x-6">
      <a href="https://www.instagram.com/djtobinn" target="_blank" rel="noopener" class={linkClass}>Instagram</a>
      <a href={getRelativeLocaleUrl(lang, "privacy")} class={linkClass}>{t.privacy}</a>
      <a href={getRelativeLocaleUrl(lang, "terms")} class={linkClass}>{t.terms}</a>
      <a href="https://karelbraborec.com" target="_blank" rel="noopener" class={linkClass}>karelbraborec.com</a>
    </nav>
  </div>
</footer>
