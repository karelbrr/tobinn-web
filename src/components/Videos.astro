---
import { toLang, ui } from "../i18n/ui";

const { videos: t } = ui[toLang(Astro.currentLocale)];
const videos = [
  { id: 1, src: "/videos/dj1.mp4", poster: "/videos/dj1.jpg" },
  { id: 2, src: "/videos/dj2.mp4", poster: "/videos/dj2.jpg" },
  { id: 3, src: "/videos/dj3.mp4", poster: "/videos/dj3.jpg" },
];
---

<section id="videos" data-stage-key="booth-wide" class="relative min-h-svh flex items-end lg:items-center px-gutter py-section">
  <div data-presence class="w-full max-w-column flex flex-col gap-8">
    <h2 class="text-heading m-0">{t.heading}</h2>
    <div class="grid grid-cols-3 gap-3">
      {
        videos.map((video) => (
          <div class="relative w-full aspect-3/4 overflow-hidden bg-ink">
            <video
              src={video.src}
              poster={video.poster}
              class="custom-video w-full h-full object-cover grayscale opacity-80 hover:opacity-100 transition-opacity duration-500 cursor-pointer"
              muted
              loop
              playsinline
              preload="metadata"
              aria-hidden="true"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const videos = document.querySelectorAll(".custom-video") as NodeListOf<HTMLVideoElement>;

    // Below Tailwind's md breakpoint there is no hover, so videos play when they come into view
    const isMobile = window.matchMedia("(max-width: 767px)").matches;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const videoObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const video = entry.target as HTMLVideoElement;

          if (isMobile) {
            if (!reducedMotion) video.play().catch(() => {});
            video.classList.remove("opacity-80");
          }

          observer.unobserve(video);
        });
      },
      { rootMargin: "200px 0px" },
    );

    videos.forEach((video) => {
      videoObserver.observe(video);

      if (!isMobile) {
        video.addEventListener("click", () => {
          if (video.paused) video.play();
          else video.pause();
        });
        video.addEventListener("mouseenter", () => {
          video.play().catch(() => {});
        });
        video.addEventListener("mouseleave", () => {
          video.pause();
          video.currentTime = 0;
        });
      }
    });
  });
</script>
