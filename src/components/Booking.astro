---
import { toLang, ui } from "../i18n/ui";

const { booking: t } = ui[toLang(Astro.currentLocale)];
const fieldClass =
  "bg-transparent border-0 border-b border-paper/30 focus:border-paper text-paper px-0 py-2 focus:outline-none transition-colors rounded-none";
const labelClass = "text-caption text-paper/60";
---

<!-- The closing shot of the DJ; opening the form leans the camera in and he looks up into it -->
<section id="book" data-stage-key="dj" class="relative min-h-svh flex items-end lg:items-center px-gutter py-section">
  <div data-presence class="w-full max-w-column flex flex-col gap-8">
    <h2 class="text-heading m-0">{t.heading}</h2>
    <p class="text-lead text-paper/85 m-0">{t.text}</p>
    <a href="mailto:booking@tobinn.cz" class="self-start text-lead underline underline-offset-4 decoration-paper/40 hover:decoration-paper transition-colors">
      booking@tobinn.cz
    </a>

    <div class="flex flex-col">
      <button
        type="button"
        id="initiate-contact-btn"
        class="self-start bg-paper text-ink px-6 py-3 rounded-full font-medium hover:bg-paper/85 active:bg-paper/70 transition-colors cursor-pointer"
      >
        {t.contact}
      </button>

      <form
        id="contact-form"
        data-sending={t.sending}
        data-sent={t.sent}
        data-error={t.error}
        class="hidden flex-col gap-5 w-full"
      >
        <input type="hidden" name="access_key" value="8cdbedee-7739-415f-ae27-9c570eef0394" />
        <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" style="display: none;" />
        <div class="flex flex-col gap-1">
          <label for="name" class={labelClass}>{t.name}</label>
          <input type="text" id="name" name="name" required class={fieldClass} />
        </div>

        <div class="flex flex-col gap-1">
          <label for="email" class={labelClass}>{t.email}</label>
          <input type="email" id="email" name="email" required class={fieldClass} />
        </div>

        <div class="flex flex-col gap-1">
          <label for="date" class={labelClass}>{t.eventDate}</label>
          <input type="date" id="date" name="date" class={fieldClass} style="color-scheme: dark;" />
        </div>

        <div class="flex flex-col gap-1">
          <label for="message" class={labelClass}>{t.message}</label>
          <textarea id="message" name="message" rows="4" required class={`${fieldClass} resize-none`}></textarea>
        </div>

        <div class="flex items-center gap-6 mt-2">
          <button type="submit" class="bg-paper text-ink px-6 py-3 rounded-full font-medium hover:bg-paper/85 active:bg-paper/70 transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed">
            {t.submit}
          </button>
          <button
            type="button"
            id="cancel-contact-btn"
            class="py-3 text-paper/60 hover:text-paper transition-colors cursor-pointer"
          >
            {t.cancel}
          </button>
        </div>
        <p id="contact-status" role="status" class="sr-only"></p>
      </form>
    </div>
  </div>
</section>

<script>
  // The stage listens for this: the camera leans in and the DJ looks up while the form is open
  function announce(open: boolean) {
    window.dispatchEvent(new CustomEvent("tobinn:booking", { detail: { open } }));
  }

  function setupBookingForm() {
    const initiateBtn = document.getElementById("initiate-contact-btn");
    const contactForm = document.getElementById("contact-form") as HTMLFormElement | null;
    const cancelBtn = document.getElementById("cancel-contact-btn");
    const status = document.getElementById("contact-status");

    if (initiateBtn && contactForm && cancelBtn) {
      initiateBtn.addEventListener("click", () => {
        initiateBtn.style.display = "none";
        contactForm.classList.remove("hidden");
        contactForm.classList.add("flex");
        document.getElementById("name")?.focus();
        announce(true);
      });

      cancelBtn.addEventListener("click", () => {
        contactForm.classList.remove("flex");
        contactForm.classList.add("hidden");
        initiateBtn.style.display = "";
        initiateBtn.focus();
        announce(false);
      });

      contactForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        const submitBtn = contactForm.querySelector('button[type="submit"]') as HTMLButtonElement;
        if (!submitBtn) return;

        const originalText = submitBtn.innerText;
        // The button shows the state, the hidden status line reads it out to a screen reader
        const show = (text: string | undefined) => {
          submitBtn.innerText = text ?? "";
          if (status) status.textContent = text ?? "";
        };
        const restore = () => {
          submitBtn.innerText = originalText;
          submitBtn.disabled = false;
          if (status) status.textContent = "";
        };
        show(contactForm.dataset.sending);
        submitBtn.disabled = true;

        try {
          const response = await fetch("https://api.web3forms.com/submit", {
            method: "POST",
            body: new FormData(contactForm),
          });

          if (response.ok) {
            show(contactForm.dataset.sent);
            contactForm.reset();
            setTimeout(() => {
              restore();
              cancelBtn.click();
            }, 3000);
          } else {
            show(contactForm.dataset.error);
            setTimeout(restore, 3000);
          }
        } catch {
          show(contactForm.dataset.error);
          setTimeout(restore, 3000);
        }
      });
    }
  }

  setupBookingForm();
</script>
