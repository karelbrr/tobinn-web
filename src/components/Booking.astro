---
---
<section
  id="booking"
  class="relative min-h-screen bg-yellow-400 text-[#050505] flex flex-col items-center overflow-hidden border-t-2 border-white/20"
>
  <!-- Distorted background grid -->
  <div
    class="absolute inset-0 bg-[linear-gradient(to_right,rgba(5,5,5,0.15)_1px,transparent_1px),linear-gradient(to_bottom,rgba(5,5,5,0.15)_1px,transparent_1px)] bg-[size:4rem_4rem] pointer-events-none"
  >
  </div>

  <div
    class="flex-grow w-full max-w-[1400px] mx-auto px-6 sm:px-12 py-24 flex flex-col justify-center relative z-10"
  >
    <div
      class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-12 items-center lg:items-end"
    >
      <!-- Text & Action -->
      <div>
        <h2
          class="display-text text-[18vw] lg:text-[9vw] leading-[0.8] tracking-tighter mb-8 sm:mb-12"
        >
          INITIATE<br />
          <span class="text-white mix-blend-overlay">CONTACT</span>
        </h2>

        <div
          class="border-l-4 border-[#050505] pl-6 py-2 space-y-4 uppercase tracking-widest text-xs sm:text-sm font-bold"
        >
          <p>Worldwide Representation</p>
          <p class="opacity-70">Awaiting booking inquiries.</p>

          <div class="pt-8 sm:pt-12">
            <a
              href="mailto:booking@tobinn.com"
              class="inline-block border-4 border-[#050505] bg-[#050505] text-yellow-400 px-6 sm:px-8 py-4 sm:py-6 hover:bg-transparent hover:text-[#050505] transition-all hover:-translate-y-2 hover:translate-x-2 hover:shadow-[-8px_8px_0px_0px_rgba(5,5,5,1)]"
            >
              <span
                class="text-xl sm:text-3xl display-text tracking-tight uppercase"
                >BOOKING@TOBINN.COM</span
              >
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
