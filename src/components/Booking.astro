---

---

<section
  id="book"
  class="py-16 sm:py-32 border-t border-white/20 relative z-10 flex flex-col items-center justify-center text-center min-h-[40vh] sm:min-h-[60vh] w-full overflow-hidden @container"
>
  <h2
    class="display-text lg:text-[19cqw] text-[15vw] text-white leading-[0.8] tracking-tighter m-0 mb-8 sm:mb-12 w-full text-center whitespace-nowrap"
  >
    BOOKING
  </h2>

  <div
    class="w-full sm:w-auto px-6 sm:px-0 flex flex-col items-center justify-center"
  >
    <button
      id="initiate-contact-btn"
      class="border-2 border-white bg-white text-black px-6 sm:px-8 py-4 font-sans font-bold text-xs sm:text-base uppercase tracking-widest hover:bg-transparent hover:text-white transition-all w-full sm:w-80 text-center block"
    >
      INITIATE CONTACT
    </button>

    <form
      id="booking-form"
      class="hidden flex-col gap-4 w-full sm:w-[400px] text-left opacity-0 transition-opacity duration-500"
      action="https://api.web3forms.com/submit"
      method="POST"
    >
      <!-- Replace this with your actual Web3Forms access key -->
      <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY_HERE" />
      <input
        type="hidden"
        name="subject"
        value="New Booking Inquiry - DJTOBINN"
      />
      <input
        type="checkbox"
        name="botcheck"
        class="hidden"
        style="display: none;"
      />

      <div class="flex flex-col gap-2">
        <label
          for="name"
          class="font-mono text-[10px] sm:text-xs text-white/70 uppercase tracking-widest"
          >Name / Organization</label
        >
        <input
          type="text"
          id="name"
          name="name"
          required
          class="bg-transparent border border-white/30 text-white px-4 py-3 font-sans focus:border-white focus:outline-none transition-colors text-sm sm:text-base rounded-none"
        />
      </div>
      <div class="flex flex-col gap-2">
        <label
          for="email"
          class="font-mono text-[10px] sm:text-xs text-white/70 uppercase tracking-widest"
          >Email Address</label
        >
        <input
          type="email"
          id="email"
          name="email"
          required
          class="bg-transparent border border-white/30 text-white px-4 py-3 font-sans focus:border-white focus:outline-none transition-colors text-sm sm:text-base rounded-none"
        />
      </div>
      <div class="flex flex-col gap-2">
        <label
          for="message"
          class="font-mono text-[10px] sm:text-xs text-white/70 uppercase tracking-widest"
          >Inquiry Details</label
        >
        <textarea
          id="message"
          name="message"
          rows="4"
          required
          class="bg-transparent border border-white/30 text-white px-4 py-3 font-sans focus:border-white focus:outline-none transition-colors text-sm sm:text-base resize-none rounded-none"
        ></textarea>
      </div>
      <button
        type="submit"
        class="border-2 border-white bg-white text-black px-6 py-4 mt-2 font-sans font-bold text-xs sm:text-sm uppercase tracking-widest hover:bg-transparent hover:text-white transition-all w-full text-center block"
      >
        SEND REQUEST
      </button>
    </form>
  </div>
</section>

<script>
  const initiateBtn = document.getElementById("initiate-contact-btn");
  const bookingForm = document.getElementById("booking-form");

  if (initiateBtn && bookingForm) {
    initiateBtn.addEventListener("click", () => {
      // Hide the button
      initiateBtn.style.display = "none";

      // Show the form
      bookingForm.classList.remove("hidden");
      bookingForm.classList.add("flex");

      // Small delay for the opacity transition to trigger
      setTimeout(() => {
        bookingForm.classList.remove("opacity-0");
        bookingForm.classList.add("opacity-100");
      }, 50);
    });

    // Handle form submission via AJAX
    bookingForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      const submitBtn = bookingForm.querySelector(
        'button[type="submit"]',
      ) as HTMLButtonElement | null;
      if (!submitBtn) return;

      const originalText = submitBtn.innerText;
      submitBtn.innerText = "SENDING...";

      const formData = new FormData(bookingForm as HTMLFormElement);

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: formData,
        });
        const data = await response.json();

        if (data.success) {
          bookingForm.innerHTML =
            '<div class="text-center py-8 border-2 border-white px-6"><h3 class="text-2xl font-bold font-sans uppercase mb-2 text-white">Message Sent</h3><p class="font-mono text-white/70 text-xs tracking-widest uppercase">We will get back to you soon.</p></div>';
        } else {
          alert(
            "Something went wrong. Please check your access key or try again.",
          );
          submitBtn.innerText = originalText;
        }
      } catch (error) {
        alert("Something went wrong. Please try again.");
        submitBtn.innerText = originalText;
      }
    });
  }
</script>
