---
import "@fontsource/geist-sans";
import "@fontsource/archivo-black";
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Official portfolio and booking site for DJ Tobinn. 17-year-old DJ focused on House, EDM, and Dance music. Booking for clubs and events."
    />
    
    <!-- Open Graph / Facebook / iMessage -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Official portfolio and booking site for DJ Tobinn. 17-year-old DJ focused on House, EDM, and Dance music." />
    <meta property="og:image" content="/og-image.png" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content="Official portfolio and booking site for DJ Tobinn. 17-year-old DJ focused on House, EDM, and Dance music." />
    <meta property="twitter:image" content="/og-image.png" />

    <title>{title}</title>
    <style is:global>
      :root {
        --bg: #050505;
        --fg: #ffffff;
      }
      body {
        background-color: var(--bg);
        color: var(--fg);
        font-family: "Geist Sans", sans-serif;
      }
      h1,
      h2,
      h3,
      h4,
      .display-text {
        font-family: "Archivo Black", sans-serif;
        text-transform: uppercase;
      }

      ::selection {
        background-color: #ffffff;
        color: #050505;
      }
    </style>
  </head>
  <body
    class="antialiased selection:bg-[#ffffff] selection:text-[#050505] border-x border-white/20 max-w-[1600px] mx-auto min-h-screen flex flex-col relative"
  >
    <slot />
    <script>
      import Lenis from "lenis";

      const lenis = new Lenis({
        autoRaf: true,
      });
    </script>
  </body>
</html>
