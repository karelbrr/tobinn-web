---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/global.css";
import { getRelativeLocaleUrl } from "astro:i18n";
import {
  defaultLang,
  getPathWithoutLang,
  languages,
  toLang,
  ui,
  type Lang,
} from "../i18n/ui";

interface Props {
  title: string;
  noindex?: boolean;
}

const { title, noindex = false } = Astro.props;
const lang = toLang(Astro.currentLocale);
const { meta } = ui[lang];

const path = getPathWithoutLang(Astro.url.pathname);
const localizedUrl = (urlLang: Lang) =>
  new URL(getRelativeLocaleUrl(urlLang, path), Astro.site).href;
const canonicalUrl = localizedUrl(lang);
const alternateLangs = Object.keys(languages) as Lang[];
const ogImageUrl = new URL("/og-image.png", Astro.site).href;
---

<html lang={lang} class="bg-ink overscroll-none">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#050505" />
    <meta name="description" content={meta.description} />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={canonicalUrl} />
          {alternateLangs.map((alternateLang) => (
            <link
              rel="alternate"
              hreflang={alternateLang}
              href={localizedUrl(alternateLang)}
            />
          ))}
          <link rel="alternate" hreflang="x-default" href={localizedUrl(defaultLang)} />
        </>
      )
    }

    <!-- Open Graph / Facebook / iMessage -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DJ TOBINN" />
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:locale" content={meta.ogLocale} />
    {
      alternateLangs
        .filter((alternateLang) => alternateLang !== lang)
        .map((alternateLang) => (
          <meta
            property="og:locale:alternate"
            content={ui[alternateLang].meta.ogLocale}
          />
        ))
    }
    <meta property="og:title" content={title} />
    <meta property="og:description" content={meta.ogDescription} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={meta.ogDescription} />
    <meta property="twitter:image" content={ogImageUrl} />

    <title>{title}</title>
    <slot name="head" />
    <script is:inline>
      // Script-only styles such as the intro loader apply only once scripts run
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body class="antialiased min-h-screen flex flex-col relative">
    <slot />
  </body>
</html>

