---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "../layouts/Layout.astro";
import LanguageSwitch from "../components/LanguageSwitch.astro";
import { toLang, ui } from "../i18n/ui";
import type { LegalDocument } from "../i18n/legal";

interface Props {
  document: LegalDocument;
}

const { document } = Astro.props;
const lang = toLang(Astro.currentLocale);
const { legal: t } = ui[lang];
---

<Layout title={`${document.title} | DJ TOBINN`} noindex>
  <main class="w-full max-w-3xl mx-auto min-h-screen px-gutter py-16 sm:py-24 flex flex-col gap-16">
    <div class="flex flex-col items-start gap-10">
      <div class="flex justify-between items-center w-full">
        <a href={getRelativeLocaleUrl(lang)} class="text-caption text-paper/60 py-2 hover:text-paper transition-colors">
          ← {t.returnToMain}
        </a>
        <LanguageSwitch />
      </div>
      <h1 class="text-display m-0">{document.title}</h1>
    </div>

    <!-- Body text kept to a readable measure of about 65 characters -->
    <div class="max-w-[65ch] text-paper/80 flex flex-col gap-10">
      {
        [...document.sections, document.closing].map((section) => (
          <section
            class:list={[
              "flex flex-col gap-3",
              section === document.closing && "border-t border-line pt-10",
            ]}
          >
            <h2 class="text-paper text-lead m-0">{section.heading}</h2>
            <p class="m-0">
              {section.body}{" "}
              {section.email && (
                <a
                  href={`mailto:${section.email}`}
                  class="text-paper underline decoration-paper/40 underline-offset-4 hover:decoration-paper transition-colors"
                >
                  {section.email}
                </a>
              )}
            </p>
          </section>
        ))
      }
    </div>
  </main>
</Layout>
