---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 | DJ TOBINN" noindex>
  <main class="min-h-screen flex flex-col justify-center px-gutter max-w-3xl mx-auto w-full gap-6">
    <h1 class="text-display m-0">404</h1>
    <p class="text-lead text-paper/80 m-0">
      Page not found. <span lang="cs" class="text-paper/60">Stránka nenalezena.</span>
    </p>
    <div class="flex gap-8 text-caption">
      <a href="/" class="py-2 underline underline-offset-4 decoration-paper/40 hover:decoration-paper transition-colors">Return home</a>
      <a href="/cs/" lang="cs" class="py-2 underline underline-offset-4 decoration-paper/40 hover:decoration-paper transition-colors">Zpět na úvod</a>
    </div>
  </main>
</Layout>
