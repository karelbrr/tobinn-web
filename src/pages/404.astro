---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 | DJTOBINN" noindex>
  <main
    class="min-h-screen flex flex-col items-center justify-center text-center px-6"
  >
    <h1
      class="display-text text-[clamp(6rem,30vw,220px)] leading-[0.8] text-white tracking-tighter mb-6"
    >
      404
    </h1>
    <p
      class="font-sans font-bold text-white uppercase tracking-widest text-3xl sm:text-4xl mb-2"
    >
      PAGE NOT FOUND
    </p>
    <p
      lang="cs"
      class="font-sans font-bold text-white/50 uppercase tracking-widest text-sm sm:text-base mb-12"
    >
      STRÁNKA NENALEZENA
    </p>
    <div class="flex gap-8">
      <a
        href="/"
        class="font-mono text-xs uppercase tracking-widest text-white border-b border-white pb-1 hover:text-white/50 hover:border-white/50 transition-colors"
      >
        RETURN HOME
      </a>
      <a
        href="/cs/"
        lang="cs"
        class="font-mono text-xs uppercase tracking-widest text-white border-b border-white pb-1 hover:text-white/50 hover:border-white/50 transition-colors"
      >
        ZPĚT NA ÚVOD
      </a>
    </div>
  </main>
</Layout>
