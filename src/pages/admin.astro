---
import '@fontsource/geist-sans';
import "../styles/global.css";
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>SYS.ADMIN // TOBINN</title>
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap" rel="stylesheet">
    <style is:global>
      :root {
        --bg: #050505;
        --fg: #ffffff;
      }
      body {
        background-color: var(--bg);
        color: var(--fg);
        font-family: 'Geist Sans', sans-serif;
      }
      .display-text {
        font-family: 'Archivo Black', sans-serif;
      }
    </style>
  </head>
  <body class="antialiased selection:bg-white selection:text-black min-h-screen p-4 sm:p-12 flex flex-col items-center justify-center">
    
    <main class="w-full max-w-3xl border border-white/20 p-6 sm:p-12 relative bg-black shadow-2xl">
      
      <!-- Decorative System Elements -->
      <div class="absolute top-0 left-0 w-2 h-2 border-t border-l border-white"></div>
      <div class="absolute top-0 right-0 w-2 h-2 border-t border-r border-white"></div>
      <div class="absolute bottom-0 left-0 w-2 h-2 border-b border-l border-white"></div>
      <div class="absolute bottom-0 right-0 w-2 h-2 border-b border-r border-white"></div>

      <!-- Header -->
      <div class="border-b border-white/20 pb-6 mb-10 flex justify-between items-end">
        <div>
          <h1 class="display-text text-4xl sm:text-5xl tracking-tighter uppercase mb-2">SYS.ADMIN</h1>
          <p class="font-mono text-[10px] tracking-widest text-white/50 uppercase">Content Management System</p>
        </div>
        <div class="hidden sm:block">
          <span class="inline-block bg-white text-black px-2 py-1 font-mono text-[10px] font-bold tracking-widest animate-pulse">AUTHORIZED</span>
        </div>
      </div>

      <!-- Form Grid -->
      <form class="flex flex-col gap-12 font-mono">
        
        <!-- SECTION: METADATA -->
        <div class="flex flex-col gap-6">
          <div class="border-b border-white/20 pb-2 mb-2">
            <h2 class="text-sm font-bold tracking-widest text-white">1. GLOBAL METADATA</h2>
          </div>
          
          <div class="flex flex-col gap-2">
            <label for="title" class="text-[10px] tracking-widest uppercase text-white/70 flex justify-between">
              <span>Site Title</span>
              <span class="text-white/30">&lt;title&gt;</span>
            </label>
            <input type="text" id="title" placeholder="e.g. TOBIN SOUND" class="bg-transparent border border-white/20 p-4 text-xs sm:text-sm text-white focus:outline-none focus:border-white transition-colors" value="TOBIN SOUND" />
          </div>

          <div class="flex flex-col gap-2">
            <label for="description" class="text-[10px] tracking-widest uppercase text-white/70 flex justify-between">
              <span>SEO Description</span>
              <span class="text-white/30">&lt;meta name="description"&gt;</span>
            </label>
            <textarea id="description" rows="3" placeholder="e.g. 17-year-old DJ focused on House and EDM..." class="bg-transparent border border-white/20 p-4 text-xs sm:text-sm text-white focus:outline-none focus:border-white transition-colors resize-none">I'M A 17-YEAR-OLD DJ FOCUSED ON HOUSE, EDM, AND DANCE MUSIC.</textarea>
          </div>
        </div>

        <!-- SECTION: TOUR DATES -->
        <div class="flex flex-col gap-6">
          <div class="border-b border-white/20 pb-2 mb-2 flex justify-between items-end">
            <h2 class="text-sm font-bold tracking-widest text-white">2. TOUR DATES</h2>
            <span class="text-[10px] text-white/50">4 UPCOMING GIGS</span>
          </div>

          <!-- Existing Row -->
          <div class="flex flex-col sm:flex-row gap-4">
            <div class="flex flex-col gap-2 w-full sm:w-1/3">
              <label class="text-[10px] tracking-widest uppercase text-white/70">Date</label>
              <input type="text" class="bg-transparent border border-white/20 p-4 text-xs text-white focus:outline-none focus:border-white" value="10.12.26" />
            </div>
            <div class="flex flex-col gap-2 w-full sm:w-1/3">
              <label class="text-[10px] tracking-widest uppercase text-white/70">City</label>
              <input type="text" class="bg-transparent border border-white/20 p-4 text-xs text-white focus:outline-none focus:border-white" value="BERLIN" />
            </div>
            <div class="flex flex-col gap-2 w-full sm:w-1/3">
              <label class="text-[10px] tracking-widest uppercase text-white/70">Venue</label>
              <div class="flex gap-2">
                <input type="text" class="bg-transparent border border-white/20 p-4 text-xs text-white focus:outline-none focus:border-white w-full" value="BERGHAIN" />
                <button type="button" class="border border-white/20 p-4 text-white/50 hover:text-red-500 hover:border-red-500 transition-colors">X</button>
              </div>
            </div>
          </div>

          <button type="button" class="border border-dashed border-white/20 text-white/50 hover:text-white hover:border-white py-4 text-xs font-bold tracking-widest transition-colors w-full">
            + ADD NEW TOUR DATE
          </button>
        </div>

        <!-- SECTION: AUDIO ARCHIVE -->
        <div class="flex flex-col gap-6">
          <div class="border-b border-white/20 pb-2 mb-2 flex justify-between items-end">
            <h2 class="text-sm font-bold tracking-widest text-white">3. AUDIO ARCHIVE</h2>
            <span class="text-[10px] text-white/50">2 MIXES</span>
          </div>

          <!-- Mix Block -->
          <div class="border border-white/20 p-6 flex flex-col gap-4">
            <div class="flex justify-between items-center">
              <span class="text-lg font-bold">MIX 01</span>
              <button type="button" class="text-xs text-white/50 hover:text-red-500 transition-colors">REMOVE</button>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="flex flex-col gap-2">
                <label class="text-[10px] tracking-widest uppercase text-white/70">Title</label>
                <input type="text" class="bg-transparent border border-white/20 p-3 text-xs text-white focus:outline-none focus:border-white" value="FOLD, LONDON" />
              </div>
              <div class="flex flex-col gap-2">
                <label class="text-[10px] tracking-widest uppercase text-white/70">Type</label>
                <input type="text" class="bg-transparent border border-white/20 p-3 text-xs text-white focus:outline-none focus:border-white" value="LIVE SET" />
              </div>
            </div>
            <div class="flex flex-col gap-2">
              <label class="text-[10px] tracking-widest uppercase text-white/70">SoundCloud Embed Link</label>
              <input type="text" class="bg-transparent border border-white/20 p-3 text-xs text-white focus:outline-none focus:border-white text-white/50" value="https://soundcloud.com/tobinn/fold-live..." />
            </div>
          </div>

          <button type="button" class="border border-dashed border-white/20 text-white/50 hover:text-white hover:border-white py-4 text-xs font-bold tracking-widest transition-colors w-full">
            + ADD NEW MIX
          </button>
        </div>

        <!-- Submit Button -->
        <div class="mt-8 pt-8 border-t border-white/20 flex flex-col sm:flex-row justify-between items-center gap-4 sticky bottom-0 bg-black py-4 z-10 border-b">
          <p class="text-[10px] text-white/40 tracking-widest">UNSAVED CHANGES DETECTED.</p>
          <button type="button" class="w-full sm:w-auto border border-white bg-white text-black px-8 py-4 font-bold text-xs uppercase tracking-widest hover:bg-black hover:text-white transition-colors">
            SAVE_ALL_CHANGES
          </button>
        </div>

      </form>
    </main>

  </body>
</html>
